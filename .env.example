# Local example values only. No real secrets.
# Copy to .env to override docker compose defaults, or export them when
# running the binary on the host.

# --- docker compose ---------------------------------------------------------
POSTGRES_PASSWORD=jungle-1234
APP_DB_PASSWORD=jungle-app-1234
KEYCLOAK_ADMIN_PASSWORD=admin

# --- service (host run: go run ./cmd/wagering) -------------------------------
APP_ROLES=api,consumer,outbox,pending
INSTANCE_ID=local-1
LOG_LEVEL=info
HTTP_ADDR=:8090
DATABASE_URL=postgres://jungle-app:jungle-app-1234@localhost:5432/jungle_test?sslmode=disable
DB_MAX_CONNS=20
DB_STATEMENT_TIMEOUT=5s
DB_LOCK_TIMEOUT=3s

# Issuer as written by Keycloak in tokens (KC_HOSTNAME) and where keys are fetched.
OIDC_ISSUER=http://localhost:8081/realms/jungle
OIDC_JWKS_URL=http://localhost:8081/realms/jungle/protocol/openid-connect/certs
OIDC_AUDIENCE=jungle-api

AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_CONSUMER_ACCESS_KEY_ID=test
SQS_CONSUMER_SECRET_ACCESS_KEY=test
SQS_PUBLISHER_ACCESS_KEY_ID=test
SQS_PUBLISHER_SECRET_ACCESS_KEY=test
SQS_INPUT_QUEUE=wager-transactions.fifo
SQS_DLQ_QUEUE=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wallet-events.fifo
SQS_CONSUMER_NAME=wager-transactions-consumer
SQS_POLLERS=2
SQS_MAX_MESSAGES=10
SQS_WAIT_TIME=10s
SQS_VISIBILITY_TIMEOUT=30s
SQS_PROCESS_TIMEOUT=20s
SQS_RETRY_BASE=2s
SQS_RETRY_MAX=5m
SQS_MAX_RECEIVES=5

OUTBOX_POLL_INTERVAL=250ms
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE=30s
OUTBOX_RETRY_BASE=1s
OUTBOX_RETRY_MAX=1m

PENDING_POLL_INTERVAL=500ms
PENDING_BATCH_SIZE=50
REFERENCE_BASE_DELAY=1s
REFERENCE_MAX_DELAY=30s
REFERENCE_MAX_ATTEMPTS=10
REFERENCE_TTL=10m

START_TIMEOUT=60s
SHUTDOWN_TIMEOUT=25s

# --- migrations ---------------------------------------------------------------
MIGRATE_DATABASE_URL=postgres://jungle:jungle-1234@localhost:5432/jungle_test?sslmode=disable

# --- integration tests (go test -tags integration ./test/...) -----------------
TEST_ADMIN_DATABASE_URL=postgres://jungle:jungle-1234@localhost:5432/postgres?sslmode=disable
TEST_KEYCLOAK_URL=http://localhost:8081
TEST_AWS_ENDPOINT_URL=http://localhost:4566
